# Copy to .env and fill in real values. Never commit .env.

# --- Data stores -------------------------------------------------------

# Postgres (pgvector-enabled) connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://caredesk:caredesk@localhost:5432/caredesk

# Redis connection string, used for the semantic cache (added later).
REDIS_URL=redis://localhost:6379/0

# Postgres URL for the indexer's DB-backed test suite (tests/ingestion/
# test_indexer.py). Must be a real, separate database — never DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://caredesk:caredesk@localhost:5432/caredesk_test

# --- Corpus ------------------------------------------------------------------

# Root directory containing the document corpus and its manifest.json.
CORPUS_ROOT=data/corpus

# --- OpenAI --------------------------------------------------------------

# OpenAI API key. Required, no default — get one from platform.openai.com.
OPENAI_API_KEY=sk-replace-me

# --- Langfuse (tracing) ---------------------------------------------------

# Langfuse public key. Required, no default.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me

# Langfuse secret key. Required, no default.
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# Langfuse ingestion host. Use https://cloud.langfuse.com or a self-hosted URL.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Models ----------------------------------------------------------------

# OpenAI embedding model used for ingestion and retrieval.
EMBEDDING_MODEL=text-embedding-3-small

# Model used for query classification / routing decisions.
CLASSIFIER_MODEL=gpt-4o-mini

# Model used for grounded answer generation.
GENERATOR_MODEL=gpt-4o

# --- Retrieval ---------------------------------------------------------------

# Number of candidates pulled from vector + keyword search prior to reranking.
RETRIEVAL_TOP_K=20

# Number of reranked candidates passed to generation.
RERANK_TOP_K=5

# --- Decision thresholds ---------------------------------------------------

# Minimum confidence required to resolve a query without escalation (0-1).
CONFIDENCE_THRESHOLD=0.7

# Soft budget ceiling per conversation in USD, used to trigger cost-aware routing.
MAX_COST_PER_CONVERSATION_USD=0.50
